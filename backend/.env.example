# CEC-codex - Environment Configuration

# =================================================================
# Hyperliquid Trading Configuration
# =================================================================

# Encryption key for private key storage (REQUIRED for Hyperliquid trading)
# Generate with: python utils/encryption.py
# Keep this secret! If lost, you cannot decrypt stored private keys.
HYPERLIQUID_ENCRYPTION_KEY=your-encryption-key-here

# Hyperliquid environment defaults
# These can be overridden per account in the database
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# API Configuration (existing)
# =================================================================

# Add your other environment variables below...

# =================================================================
# CoinGlass Paid Market Data
# =================================================================
# Keep this key server-side. The frontend only calls /api/coinglass.
COINGLASS_API_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_API_KEY=your-coinglass-api-key

# =================================================================
# Authentication (local account register + login)
# =================================================================
# Users register and log in with a username + password stored in the local
# database (PBKDF2-hashed). The backend issues a locally-signed JWT — no external
# identity provider, no domain required.
#
# AUTH_ENABLED=true  -> login required (register first, then log in).
# AUTH_ENABLED=false -> no login at all; everything runs as one shared local user.
AUTH_ENABLED=true

# REQUIRED when AUTH_ENABLED=true. Set to a strong random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, an insecure development default is used (sessions are not secure).
AUTH_SECRET_KEY=change-me-to-a-long-random-string

# How long an issued login token stays valid.
AUTH_TOKEN_TTL_DAYS=30

# =================================================================
# Hyper AI LLM Configuration (auto-applied on first startup)
# =================================================================
# If set, these override any existing Hyper AI LLM config saved in the database
# on startup (only applies when no provider has been configured yet).
# Supported providers: deepseek, openai, anthropic, gemini, custom
HYPER_AI_LLM_PROVIDER=deepseek
HYPER_AI_LLM_API_KEY=your-deepseek-api-key
HYPER_AI_LLM_MODEL=deepseek-v4-pro

# Optional: path to an image file to inject as initial visual context
# at the start of every new Hyper AI conversation.
HYPER_AI_INIT_IMAGE=/path/to/your/image.png
