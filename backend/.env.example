# Hyper Alpha Arena - Environment Configuration

# =================================================================
# Hyperliquid Trading Configuration
# =================================================================

# Encryption key for private key storage (REQUIRED for Hyperliquid trading)
# Generate with: python utils/encryption.py
# Keep this secret! If lost, you cannot decrypt stored private keys.
HYPERLIQUID_ENCRYPTION_KEY=your-encryption-key-here

# Hyperliquid environment defaults
# These can be overridden per account in the database
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# API Configuration (existing)
# =================================================================

# Add your other environment variables below...

# =================================================================
# CoinGlass Paid Market Data
# =================================================================
# Keep this key server-side. The frontend only calls /api/coinglass.
COINGLASS_API_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_API_KEY=your-coinglass-api-key

# =================================================================
# Casdoor / OAuth Login
# =================================================================
# Create the Casdoor Application first, then paste its Client ID here.
AUTH_PROXY_UPSTREAM=https://auth.bocail.com
AUTH_PROVIDER=https://auth.bocail.com
AUTH_PROXY_PROVIDER=https://www.bocail.com
AUTH_CLIENT_ID=your-casdoor-application-client-id
AUTH_APP_NAME=hyper-alpha-arena
AUTH_ORGANIZATION_NAME=built-in
AUTH_REDIRECT_PATH=/callback

# Provider names must match the Provider names configured inside Casdoor.
AUTH_GITHUB_PROVIDER_NAME=github_login
AUTH_GITHUB_CLIENT_ID=Ov23liwdTwGyhQkcFrYK
AUTH_GOOGLE_PROVIDER_NAME=google_login
AUTH_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_REDACTED
